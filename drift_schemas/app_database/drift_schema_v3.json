  "fixed_sql": [
    {
      "name": "decks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"decks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"subject\" TEXT NOT NULL DEFAULT '', \"source_file_name\" TEXT NOT NULL, \"file_hash\" TEXT NOT NULL, \"page_count\" INTEGER NOT NULL, \"language\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "questions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"questions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"deck_id\" INTEGER NOT NULL REFERENCES decks (id) ON DELETE CASCADE, \"type\" TEXT NOT NULL, \"prompt\" TEXT NOT NULL, \"answer\" TEXT NOT NULL, \"accepted_answers\" TEXT NOT NULL DEFAULT '[]', \"choices\" TEXT NOT NULL DEFAULT '[]', \"items\" TEXT NOT NULL DEFAULT '[]', \"underlined_word\" TEXT NULL, \"correction\" TEXT NULL, \"explanation\" TEXT NOT NULL, \"source_page\" INTEGER NOT NULL, \"difficulty\" TEXT NOT NULL DEFAULT 'medium');"
        }
      ]
    },
    {
      "name": "card_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"card_states\" (\"question_id\" INTEGER NOT NULL REFERENCES questions (id) ON DELETE CASCADE, \"state\" INTEGER NOT NULL, \"step\" INTEGER NULL, \"stability\" REAL NULL, \"difficulty\" REAL NULL, \"due\" INTEGER NOT NULL, \"last_review\" INTEGER NULL, PRIMARY KEY (\"question_id\"));"
        }
      ]
    },
    {
      "name": "review_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"question_id\" INTEGER NOT NULL REFERENCES questions (id) ON DELETE CASCADE, \"rating\" INTEGER NOT NULL, \"was_correct\" INTEGER NOT NULL CHECK (\"was_correct\" IN (0, 1)), \"answered_text\" TEXT NULL, \"reviewed_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "note_sections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"note_sections\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"deck_id\" INTEGER NOT NULL REFERENCES decks (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"heading\" TEXT NOT NULL, \"points\" TEXT NOT NULL, \"source_page\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"language\" TEXT NOT NULL DEFAULT 'taglish', \"new_cards_per_day\" INTEGER NOT NULL DEFAULT 20, \"theme_mode\" TEXT NOT NULL DEFAULT 'system', \"onboarding_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarding_done\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
}